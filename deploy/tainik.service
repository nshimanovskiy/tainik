# Вариант без Docker: systemd-служба. Перед ней нужен Caddy или nginx с HTTPS
# (пример для Caddy — deploy/Caddyfile.host). Установка:
#   sudo useradd --system --home /var/lib/tainik --shell /usr/sbin/nologin tainik
#   sudo mkdir -p /opt/tainik /var/lib/tainik && sudo chown tainik:tainik /var/lib/tainik
#   sudo cp -r package.json server shared client /opt/tainik/
#   sudo cp deploy/tainik.service /etc/systemd/system/ && sudo systemctl enable --now tainik
[Unit]
Description=Tainik E2E messenger server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tainik
Group=tainik
WorkingDirectory=/opt/tainik
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/tainik/server/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/tainik
Environment=TRUST_PROXY=1
Environment=QUEUE_TTL_DAYS=30
Restart=on-failure
RestartSec=3

# Изоляция
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tainik
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
