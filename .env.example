# Скопируйте в .env и заполните:  cp .env.example .env

# Домен, указывающий на IP вашего VPS (A-запись в DNS)
DOMAIN=chat.example.com

# Почта для Let's Encrypt (certbot)
ACME_EMAIL=admin@example.com

# Локальный порт сервера (слушает только 127.0.0.1, к нему проксирует nginx)
TAINIK_PORT=8787

# Сколько дней хранить сообщения для устройств, которые долго не подключались
QUEUE_TTL_DAYS=30

# Вложения: самый большой файл (МБ) и место под все файлы (ГБ). Файлы хранятся
# зашифрованными и удаляются через QUEUE_TTL_DAYS дней.
MAX_UPLOAD_MB=100
MAX_STORAGE_GB=20

# Одновременных подключений с одного IP
MAX_CONN_PER_IP=100

# Панель администратора: https://ваш-домен/adminadminadmin/
# Пароль не короче 12 символов (лучше сгенерировать: openssl rand -base64 24).
# Пусто — панель выключена. Путь можно поменять.
ADMIN_PASSWORD=
ADMIN_PATH=/adminadminadmin

# Загрузки на главной странице и самообновление приложений: откуда брать релизы.
# Сервер скачивает их с GitHub и отдаёт со своего домена. Пусто — выключено.
RELEASES_REPO=nshimanovskiy/tainik
# Только для приватного репозитория: токен с правом чтения (Contents: Read-only)
GITHUB_TOKEN=

# Подписка «Тайник Премиум» (пока даёт фото профиля), оплата — криптовалютой через xRocket Pay.
# 1) В Telegram откройте @xRocket → Pay API → «Создать приложение»; в его настройках
#    API Version → Current, затем выпустите «API Token» и «Webhook Token».
# 2) Адрес вебхука сервер передаёт в каждом счёте сам: https://DOMAIN/api/pay/xrocket
#    (можно указать его и в настройках приложения xRocket).
# Пусто — подписка выключена. Для проверки без денег: токен из @xrocket_testnet_bot и XROCKET_TESTNET=1.
XROCKET_PAY_TOKEN=
XROCKET_WEBHOOK_SECRET=
XROCKET_TESTNET=0
# Тарифы: «дни:цена» через запятую, цена — в PREMIUM_CURRENCY. Пример: 30:3,90:8,365:30
PREMIUM_PLANS=30:3
PREMIUM_CURRENCY=USDT
# Чем ещё можно заплатить (коды xRocket через запятую): сумма — по курсу xRocket в момент счёта,
# с округлением вверх. Пусто — только PREMIUM_CURRENCY. Коды, которых нет в xRocket, сервер пропустит.
PREMIUM_PAY_CURRENCIES=GRAM,TRX
# Монеты — внутренняя валюта: покупаются за криптовалюту, ими платят за Премиум (позже — за подарки).
# Пакеты «монеты:цена» (цена в PREMIUM_CURRENCY); пусто — монеты не продаются.
COIN_PACKS=100:1,550:5,1200:10
# Сколько монет стоит 1 единица PREMIUM_CURRENCY: Премиум 30:3 → 300 монет. 0 — Премиум за монеты не продаётся.
COINS_PER_UNIT=100

# Официальный канал «Обновления Тайника» (@tainik): сервер сам публикует в нём патчноуты новых версий
# из CHANGELOG.md, все пользователи подписаны. 0 — выключить.
NEWS_CHANNEL=1
