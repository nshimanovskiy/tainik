# Скопируйте в .env и заполните:  cp .env.example .env

# Домен, указывающий на IP вашего VPS (A-запись в DNS)
DOMAIN=chat.example.com

# Почта для Let's Encrypt (certbot или Caddy)
ACME_EMAIL=admin@example.com

# Локальный порт сервера (слушает только 127.0.0.1, к нему проксирует nginx)
TAINIK_PORT=8787

# Сколько дней хранить сообщения для устройств, которые долго не подключались
QUEUE_TTL_DAYS=30

# Одновременных подключений с одного IP
MAX_CONN_PER_IP=20

# Панель администратора: https://ваш-домен/adminadminadmin/
# Пароль не короче 12 символов (лучше сгенерировать: openssl rand -base64 24).
# Пусто — панель выключена. Путь можно поменять.
ADMIN_PASSWORD=
ADMIN_PATH=/adminadminadmin

# Загрузки на главной странице и самообновление приложений: откуда брать релизы.
# Сервер скачивает их с GitHub и отдаёт со своего домена. Пусто — выключено.
RELEASES_REPO=nshimanovskiy/tainik
# Только для приватного репозитория: токен с правом чтения (Contents: Read-only)
GITHUB_TOKEN=
