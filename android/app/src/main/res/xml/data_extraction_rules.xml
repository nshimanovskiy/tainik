<?xml version="1.0" encoding="utf-8"?>
<!-- Ключи и переписку не копируем ни в облако, ни на новый телефон: ключ шифрования
     хранилища живёт в Android Keystore этого устройства и всё равно не переносится. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
